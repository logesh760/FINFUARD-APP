# ==============================================================================
# FINGUARD SECURITY — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# WARNING: NEVER commit actual secrets, API keys, or private keystores into git.
# Production secrets must be provisioned via your cloud hosting provider's
# secret management system (e.g. Google Cloud Secret Manager, AWS Secrets Manager).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & SERVER ENVIRONMENT
# ------------------------------------------------------------------------------
# Options: development | test | staging | production
NODE_ENV="production"

# Server listening port
PORT="8080"

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE AI ENGINE CREDENTIALS (NEVER EXPOSE TO MOBILE CLIENT)
# ------------------------------------------------------------------------------
# Server-side Gemini API key used exclusively by the backend microservice.
# The mobile client NEVER receives or stores this key.
GEMINI_API_KEY="your_cloud_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSION MANAGEMENT
# ------------------------------------------------------------------------------
# Secret used to sign short-lived (15-min) HMAC-SHA256 client session tokens.
# Must be at least 32 cryptographically random bytes in production.
SESSION_SIGNING_SECRET="your_32_byte_cryptographic_session_secret_hex"

# Optional fallback client token for testing / development
FINGUARD_CLIENT_TOKEN=""

# ------------------------------------------------------------------------------
# 4. RATE LIMITING & SECURITY THRESHOLDS
# ------------------------------------------------------------------------------
# Maximum allowed requests per IP/session within the sliding window
RATE_LIMIT_MAX_REQUESTS="60"

# Sliding window duration in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS="60000"

# Server-side request processing timeout in milliseconds (default: 15000 = 15s)
REQUEST_TIMEOUT_MS="15000"

# Allowed CORS origins (comma-separated list).
# Leave empty for pure mobile clients where browser CORS is inapplicable.
ALLOWED_ORIGINS=""

# ------------------------------------------------------------------------------
# 5. PUBLIC PRODUCTION DOMAIN STATUS
# ------------------------------------------------------------------------------
# Status: CONFIGURED (Render Free Tier)
# Live Public Gateway URL: https://finfuard-app.onrender.com
PUBLIC_GATEWAY_URL="https://finfuard-app.onrender.com"
