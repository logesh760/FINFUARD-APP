# ==============================================================================
# FINGUARD AI GATEWAY — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# DO NOT COMMIT THE ACTUAL .env FILE.
# Manage production variables in Cloud Secret Manager / ECS Environment.

NODE_ENV=production
PORT=8080

# Google Gemini API Key (Server-side only)
GEMINI_API_KEY=your_gemini_api_key_here

# 32+ byte cryptographic secret for HMAC-SHA256 session token generation
SESSION_SIGNING_SECRET=your_32_byte_cryptographic_session_secret_hex

# Sliding Window Rate Limiting (60 requests / 60 seconds)
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_MS=60000

# Request timeout limit in milliseconds
REQUEST_TIMEOUT_MS=15000

# Strict CORS allowed origins (comma-separated; empty for mobile app only)
ALLOWED_ORIGINS=

# Public domain status: CONFIGURED (Render)
PUBLIC_GATEWAY_URL="https://finfuard-app.onrender.com"
